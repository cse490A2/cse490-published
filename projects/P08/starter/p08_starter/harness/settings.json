{
  "model": {
    "default": "internal/Qwen3.6-35B-A3B",
    "timeout_seconds": 120,
    "max_tool_rounds": 25
  },
  "router": {
    "enabled": true,
    "decider_url": "http://127.0.0.1:8000/v1/systemone",
    "fallback_model": "external/haiku-5-5",
    "threshold": 0.5,
    "questions": {
      "quality": {
        "question": "Does the response correctly and completely answer the user's question?"
      }
    },
    "timeout_seconds": 60,
    "max_state_chars": 12000
  },
  "tools": {
    "execute_timeout_seconds": 10,
    "max_output_chars": 60000
  },
  "mcpServers": {
    "github": {
      "command": "./mcp/github-mcp-server",
      "args": [
        "stdio",
        "--tools",
        "get_file_contents,search_code,list_issues,issue_read,add_issue_comment,create_branch,create_pull_request,pull_request_read"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "permissions": {
    "deny": [
      "git push origin main",
      "git push --force",
      "git push -f",
      "create_or_update_file",
      "push_files",
      "delete_file"
    ]
  }
}
